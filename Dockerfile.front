# Dockerfile.front

FROM node:24-slim AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

# Copy workspace manifests first to maximize dependency layer reuse.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc .localerc.json ./
COPY apps/front-end/package.json ./apps/front-end/

RUN --mount=type=cache,id=flow-pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Copy application source after dependencies so source changes keep installs cached.
COPY apps/front-end ./apps/front-end

# Generate ignored production locale bundles, including automatic zh-Hant output.
RUN pnpm locale make flow --prod
RUN pnpm --filter @fuyeor/flow-front-end test
RUN pnpm --filter @fuyeor/flow-front-end build

FROM nginx:alpine AS runner

RUN rm -rf /usr/share/nginx/html/*

COPY --from=builder /app/apps/front-end/dist /usr/share/nginx/html

RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    server_name localhost;' \
    '    root /usr/share/nginx/html;' \
    '    include mime.types;' \
    '    index index.html;' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
